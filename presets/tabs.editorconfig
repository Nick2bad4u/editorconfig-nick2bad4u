root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
tab_width = 4
trim_trailing_whitespace = true

[*.{json,jsonc,md,yaml,yml}]
indent_size = 2
indent_style = space

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

[LICENSE*]
trim_trailing_whitespace = false
